  "start": {
    "name": "作者 / Fifteen",
    "text": "感谢您的支持与游玩。开始前须知：[br]本作为佣囚同人作品《窒息》的文字剧情游戏，[br]当前版本为demo试玩版。",
    "next": "start2"
