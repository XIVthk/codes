  "start2": {
    "name": "作者 / Fifteen",
    "text": "基本键位：[br]使用[Space]或[Enter]切换下一条对话；[br]使用[Ctrl-S/O]保存/读取进度(每5分钟自动保存1次)；[br]使用[Ctrl-L]查看历史对话记录。",
    "next": "start3"
  },
  "start3": {
    "name": "作者 / Fifteen",
    "text": "请点击[开始游玩]按钮进入游戏。",
